<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kz.green.app"
    android:versionCode="2"
    android:versionName="1.1">

    <!-- Android 6.0+ (Samsung A53: Android 12–16). Интернет рұқсаты керек емес:
         барлық файлдар APK ішінде, қосымша офлайн жұмыс істейді. -->
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- Жүйелік саусақ ізі / бет тану терезесі (қалыпты рұқсат, пайдаланушыдан сұралмайды) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|fontScale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
